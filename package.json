{
  "name": "otomat",
  "version": "1.0.0",
  "keywords": [],
  "description": "Library for working with finite automata (DFA/NFA), including simulation, NFA→DFA conversion (with step-by-step support), epsilon transitions, serialization, and DOT export.",
  "license": "MIT",
  "author": "Yunus Alper Göl <yalperg>",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node esbuild.config.js",
    "dev": "NODE_ENV=development node esbuild.config.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:perf": "jest --testMatch='**/tests/performance/**/*.test.ts' --runInBand --coverage=false",
    "typecheck": "tsc --noEmit --incremental false",
    "test:package": "node --test tests/integration/package.test.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run test:package",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.29",
    "esbuild": "^0.25.5",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  }
}
