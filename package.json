{
  "name": "otomat",
  "version": "1.0.1",
  "packageManager": "pnpm@8.6.6",
  "keywords": [
    "automata",
    "finite-automata",
    "dfa",
    "nfa",
    "typescript",
    "graphviz"
  ],
  "description": "Library for working with finite automata (DFA/NFA), including simulation, NFA→DFA conversion (with step-by-step support), epsilon transitions, serialization, and DOT export.",
  "license": "MIT",
  "author": {
    "name": "Yunus Alper Göl",
    "url": "https://github.com/yalperg"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yalperg/otomat.git"
  },
  "bugs": {
    "url": "https://github.com/yalperg/otomat/issues"
  },
  "homepage": "https://github.com/yalperg/otomat#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node esbuild.config.js",
    "dev": "NODE_ENV=development node esbuild.config.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:perf": "jest --testMatch='**/tests/performance/**/*.test.ts' --runInBand --coverage=false",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.29",
    "esbuild": "^0.25.5",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  }
}
